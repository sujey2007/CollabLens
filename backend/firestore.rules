rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NOTE: This backend writes to Firestore using the Admin SDK (server-side,
    // authenticated with a service account), which bypasses these rules.
    // These rules only matter if you later let the mobile app read/write
    // Firestore directly with the client SDK. Locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
