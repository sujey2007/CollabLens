# Copy this file to `.env` and fill in real values before running the backend.

# Option A: point to a local service account key file (default lookup path
# is backend/serviceAccountKey.json if this is left unset)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option B: paste the full service account JSON as a single-line string
# (useful for platforms like Render/Railway/Heroku where you can't upload files)
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", ...}

# Mock demo login (replace with real auth before shipping)
COLLABLENS_DEMO_USER=sujey
COLLABLENS_DEMO_PASS=24680
